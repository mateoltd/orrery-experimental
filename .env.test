# Test-only compose overrides. NOT a secret file: these are the local development
# credentials that appear in .env.example and in the plan, and the schema gate asserts the
# DDL is safe on a populated database.
#
# Why a separate file: the host ports are moved off the defaults because 5432 and 6379 are
# frequently already allocated on a developer machine or a CI runner. A hardcoded port turns
# "the database did not start" into a bind error, which is a confusing way to learn that
# something else has the port.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
MINIO_HOST_PORT=59000
MINIO_CONSOLE_HOST_PORT=59001
SMTP_HOST_PORT=51025
MAILPIT_HOST_PORT=58025
OTLP_HOST_PORT=54317
OTLP_HTTP_HOST_PORT=54318

DATABASE_URL=postgresql://orrery:orrery@localhost:55432/orrery
