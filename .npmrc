engine-strict=true
strict-peer-dependencies=false
auto-install-peers=true
# ADR-0008: exact pinning via the lockfile. No ^ ranges in package.json for runtime deps.
save-exact=true

# pnpm's isolated node_modules is incompatible with Prisma's client resolution.
#
# Prisma's generator requires the client to sit exactly one level ABOVE the CLI:
# `relative(cliDir, clientDir)` must begin with a single `..`. That is npm's flat
# node_modules layout. pnpm's symlinked store makes it `../../..`, so
# `prisma generate` fails with:
#
#   Could not resolve @prisma/client despite the installation that we just tried
#
# — a message that blames installation while the real cause is directory layout.
# Found by reading the failing condition inside @prisma/client's generator, not by
# reading the error. Four wrong diagnoses came first: a missing OpenSSL package, a
# blocked pnpm postinstall, a missing root dependency, and a missing explicit
# `output`.
#
# The hoisted linker restores npm's flat layout, keeps the documented
# `@prisma/client` import path working, and costs disk rather than correctness.
node-linker=hoisted
