# Placeholders only. Real values live in the platform secret store and are injected
# at runtime — never in the image, never in git (14 §8, and scripts/scan-secrets.sh).
# Copy to .env for local development; `pnpm env:check` validates the result.

NODE_ENV=development

# ── datastores ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://orrery:orrery@localhost:5432/orrery
REDIS_URL=redis://localhost:6379

# ── object storage (S3-compatible; MinIO locally) ────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_ASSETS=orrery-assets
S3_BUCKET_SIMS=orrery-sims
S3_ACCESS_KEY_ID=orrery
S3_SECRET_ACCESS_KEY=orrery-secret
S3_FORCE_PATH_STYLE=true

# ── email (Mailpit locally; a real transactional provider in prod) ────────────────
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Orrery <no-reply@example.invalid>

# ── auth ──────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-bytes-of-entropy
APP_URL=http://localhost:3000
# The dedicated static origin simulation bundles are served from. It MUST be a different host from
# APP_URL: with the bundle on the app origin, a simulation's bugs reach our cookies even through a
# cross-origin frame, and the sandbox stops being real rather than advisory.
SIM_ORIGIN=http://localhost:3001

# ── observability ────────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# ── product defaults, overridable per environment ────────────────────────────────
DEFAULT_LOCALE=en-GB
SUPPORT_EMAIL=support@example.invalid
# P0-T9 must source or delete the concurrency target. 150 is the honest default for a
# single-school pilot; the architecture stays scale-horizontal (23 D-22).
TARGET_CONCURRENT_EXAM_TAKERS=150
