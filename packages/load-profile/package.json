{
  "name": "@orrery/load-profile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "default": "./dist/harness.js"
    },
    "./correctness": {
      "types": "./dist/correctness.d.ts",
      "default": "./dist/correctness.js"
    },
    "./leg": {
      "types": "./dist/leg.d.ts",
      "default": "./dist/leg.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@orrery/rng": "workspace:*",
    "@orrery/db": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "3.23.2"
  }
}
