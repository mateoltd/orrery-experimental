{
  "name": "@orrery/interop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./boundary": {
      "types": "./dist/boundary.d.ts",
      "default": "./dist/boundary.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "default": "./dist/codec.js"
    },
    "./csp": {
      "types": "./dist/csp.d.ts",
      "default": "./dist/csp.js"
    },
    "./outbound": {
      "types": "./dist/outbound.d.ts",
      "default": "./dist/outbound.js"
    },
    "./digest": {
      "types": "./dist/digest.d.ts",
      "default": "./dist/digest.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "vitest": "3.2.7"
  }
}
