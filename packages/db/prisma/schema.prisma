// Orrery — data model v2. Corrected per plans/23-REVIEW-ACTIONS.md (B1–B5, B11, B12, B15, B16, C7, C12, C14, C15, C27, U-6, V-4, V-7, V-12).
//
// This file is the machine-readable contract. It MUST pass `prisma validate` (blocking CI gate).
//
// ── Conventions ────────────────────────────────────────────────────────────────────
//   • IDs: uuid(7) for foreign keys (index locality).
//     uuid(4) for anything that functions as a BEARER CAPABILITY reachable by URL:
//     AttemptSession.id, ReviewTaskClaim.id, Invitation code plaintext. Time-ordered ids
//     are enumerable and B7 showed that is a real exposure.
//   • tenantId on every tenant-scoped table (D2/D-23). Nullable; unused at launch.
//   • Points/weights: Decimal(9,2). Never Float.
//   • Instants: DateTime @db.Timestamptz(3), UTC — on EVERY instant column, no exceptions.
//     B3 found 17 audit-critical columns that were plain TIMESTAMP(3). A CI gate now
//     greps the generated DDL for TIMESTAMP(3) without TZ and fails.
//   • JSONB: block content, question specs (THE ANSWER KEY), policy, manifest, evidence.
//   • Every consequential mutation writes an AuditEvent in the same transaction.
//
// ── What Prisma CANNOT express, and therefore must be hand-written in migration 0001 ──
//   1. CREATE EXTENSION citext, pg_trgm, btree_gin
//   2. Partial unique indexes — Prisma has no syntax for these:
//        one IN_PROGRESS attempt per (assignment, student)          -> 23505 = ATTEMPT_ALREADY_ACTIVE
//        one live (unrevoked) session per attempt
//   3. CHECK constraints (0 <= autoScore <= maxPoints, select-all gameability guard)
//   4. Triggers for updatedAt on tables Prisma does not manage
//   If a constraint you need is not expressible here, it goes in the migration and the
//   schema header says so. This file is not the whole truth.

generator client {
  provider = "prisma-client-js"
  // An EXPLICIT output is required under pnpm's isolated node_modules. Without it the
  // default target `node_modules/.prisma/client` is not resolvable from the package, and
  // `prisma generate` fails with "Could not resolve @prisma/client" — a message that
  // points at installation rather than at output resolution. Found by reading the actual
  // failure, not by reading the docs.
  // Relative to the SCHEMA directory, not the package root.
  output   = "./generated/client"   // -> packages/db/prisma/generated/client
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────────────── identity

model User {
  id            String     @id @default(uuid(7))
  tenantId      String?
  // B4: unique case-SENSITIVELY by default, which broke roster re-import, placeholder
  // matching, magic links and invitations. citext + an explicit normalised column so
  // normalisation is a code invariant and not a collation accident.
  email           String     @unique @db.Citext
  emailNormalized String     @unique
  emailVerified   Boolean    @default(false)
  name            String
  avatarUrl       String?
  status          UserStatus @default(ACTIVE)
  locale          String     @default("en-GB")
  timezone        String     @default("UTC")

  // minors posture
  isMinor         Boolean   @default(false)
  guardianEmail   String?
  guardianConsentAt DateTime? @db.Timestamptz(3)

  // INV-AUTH-1 + C25: the per-user session-cache epoch.
  //
  // Bumped in the SAME TRANSACTION as every session revoke, and read FRESH (never cached) on
  // every request. A cached session row is served only while this still matches, which is how a
  // 60-second cache stops defeating "a suspension takes effect on the next request".
  //
  // This column did not exist when the cache was designed, and the cache was written against
  // it anyway — a unit test with a fake store passed happily against a schema that could not
  // possibly support it. Only applying the migration to a real database surfaced it. The
  // lesson is the same one as the coverage config that silently stopped measuring: a mock
  // cannot tell you whether the thing you mocked exists.
  sessionsEpoch   Int       @default(0)

  // lifecycle
  deletingAt      DateTime? @db.Timestamptz(3)
  // INV-QUOTA-1. BigInt, not Int: 2^31 bytes is 2 GB, and a school's shared account would cross
  // that on one term of uploaded photographs. `storageUsedBytes` is only ever moved by the
  // conditional UPDATE in `quota.ts`, never read-then-written. The default is 1 GB and it is
  // asserted equal to `DEFAULT_QUOTA_BYTES` in the quota test, because "the default" living in
  // two places is how a migration and a new account end up with different limits.
  storageQuotaBytes BigInt @default(1000000000)
  storageUsedBytes  BigInt @default(0)
  deletedAt       DateTime? @db.Timestamptz(3)
  anonymisedAt    DateTime? @db.Timestamptz(3)
  // When the suspension happened, as well as why. The lifecycle policy has always written
  // both — "your account is suspended" with no date is not an answer a support agent can act
  // on, and `suspendedReason` alone cannot answer "is this the same suspension from March".
  suspendedAt    DateTime? @db.Timestamptz(3)
  suspendedReason String?
  lastLoginAt     DateTime? @db.Timestamptz(3)
  mfaEnabled      Boolean   @default(false)
  mfaSecretEnc    String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  accounts              Account[]
  sessions              Session[]
  resources             Resource[]
  resourceVersions      ResourceVersion[]
  banks                 QuestionBank[]
  blueprints            Blueprint[]
  classroomsOwned       Classroom[]             @relation("ClassroomOwner")
  enrollments           Enrollment[]
  invitesSent           ClassroomInvitation[]   @relation("InviteSent")
  invitesAccepted       ClassroomInvitation[]   @relation("InviteAccepted")
  assignmentsCreated    Assignment[]            @relation("AssignmentAuthor")
  studentOverridesGiven AssignmentStudentOverride[] @relation("OverrideGrantor")
  attempts              ExamAttempt[]
  responsesGraded       QuestionResponse[]      @relation("ResponseGrader")
  reviewTasksClaimed    ReviewTask[]            @relation("ReviewClaimer")
  reviewAssignments     ReviewAssignment[]      @relation("ReviewAssignee")
  reviewGrants          ReviewerGrant[]
  releaseBatches        ReleaseBatch[]
  verdicts              IntegrityVerdict[]
  feedback              Feedback[]
  auditEvents           AuditEvent[]
  securityEvents        SecurityEvent[]
  notifications         Notification[]
  simDrafts             SimulationDraft[]
  assets                Asset[]
  ratings               Rating[]
  comments              Comment[]
  accommodationsGranted Accommodation[]         @relation("AccommodationGrantor")
  accommodationsHeld    Accommodation[]         @relation("AccommodationStudent")
  accommodationRequests AccommodationRequest[]  @relation("RequestStudent")
  accommodationDecided  AccommodationRequest[]  @relation("RequestDecider")

  @@index([status, createdAt])
  @@index([tenantId])
  @@index([emailNormalized])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETING
  DELETED
}

/// A security-relevant EVENT, distinct from AuditEvent.
///
/// The split is load-bearing and the reason both tables exist:
///
///   · `AuditEvent` answers "who did what to what, and can we explain it to a teacher?"
///   · `SecurityEvent` answers "did something happen that a human should look at?"
///
/// A security event is a SIGNAL, never a verdict. `plans/09` is explicit that integrity and
/// account telemetry are evidence for a human, not an automated judgement — so this table
/// records that a pattern was seen and deliberately carries no `severity` that anything is
/// allowed to branch on automatically. Automatic consequences live in the state machine
/// (INV-AUTH-1: reuse of a revoked token revokes the family), which is decided at write time
/// by a human-readable rule, not by reading this table back.
///
/// `dedupeKey` exists because the events worth raising are the ones that repeat, and a
/// repeated MFA failure should be one row that increments, not ten thousand rows.
model SecurityEvent {
  id          String   @id @default(uuid(7))
  /// Which family of signal: reuseOfRevokedToken, mfaFailure, impossibleTravel, …
  kind        String
  /// The account the signal is about. NOT NULL: a security event nobody is accountable for
  /// is a log line, and log lines do not get investigated. Set to the user involved even when
  /// the event is about an attempt against them.
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// How many times this exact signal has been seen. A first MFA typo is noise; the fifth
  /// is a takeover attempt, and the difference is the count.
  occurrences Int      @default(1)
  /// Stable key for the counter, e.g. `mfa-failure:{userId}:{ipPseudonym}:{10-minute bucket}`.
  /// Without it, deduplication would have to guess.
  dedupeKey   String
  /// Structured detail. Secrets never go here — it is read by humans in a review queue, and
  /// a review queue is exactly the wrong place to store a token or a raw IP.
  meta        Json     @default("{}")
  /// Set once a human has looked. The packet's "anomaly signals to a review queue" is this
  /// column plus the queue; the queue is P8, the column is here so the rows are not lost when
  /// it arrives.
  reviewedAt  DateTime? @db.Timestamptz(3)
  reviewedBy  String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([dedupeKey])
  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([reviewedAt, createdAt])
}

model Account {
  id                    String    @id @default(uuid(7))
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String? // argon2id
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
}

// INV-AUTH-1: sessions live in Postgres so revocation is immediate (next request).
// A Redis cache is allowed but MUST be invalidated in the same transaction as any
// revoke — C25 found a 60s cache silently defeating the invariant.
model Session {
  id            String    @id @default(uuid(4))
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  familyId      String
  expiresAt     DateTime  @db.Timestamptz(3)
  ipHash        String?
  // Stored as evidence for an investigation, but NEVER sent to the browser: the device list
  // shows a coarse label (describeDevice) so a fingerprintable string does not end up on the
  // wire or in a screenshot of a student's own account page.
  userAgent     String?
  // P1-T4 requires the sessions page to show "last seen". Absent originally, which the
  // integration suite caught the moment listSessions selected it — the third schema gap the
  // real-database run has found, and the reason it keeps finding them.
  //
  // Written on a slide, not on every request: an UPDATE per request on the hottest table during
  // an assessment window is a real cost for a field a human reads once a month.
  lastSeenAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  revokedReason String?

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([familyId])
}

// VerificationToken is keyed by identifier (an email), not userId — it deliberately has
// no relation to User. B1 flagged a dangling back-array here.

// ─────────────────────────────────────────────────────────────────── taxonomy

model Subject {
  id          String  @id @default(uuid(7))
  slug        String  @unique
  name        String
  description String?
  colour      String?
  position    Int     @default(0)
  parentId    String?
  parent      Subject?  @relation("SubjectTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Subject[] @relation("SubjectTree")

  resources Resource[]
  sims      Simulation[]

  @@index([parentId, position])
}

model Tag {
  id        String   @id @default(uuid(7))
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  resources ResourceTag[]
  questions QuestionTag[]
}

// ───────────────────────────────────────────────────────────────────── content

enum ResourceKind {
  LESSON
  QUIZ
  EXAM
}

enum ResourceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  /// `plans/01` §Resource lists only {DRAFT, PUBLISHED, ARCHIVED}, and the P2-T8 packet asks for
  /// WITHDRAWN "plus" those. WITHDRAWN belongs to Assignment in the plan, so the packet is
  /// conflating two lifecycles — but the need behind it is real and ARCHIVED does not cover it.
  ///
  /// ARCHIVED means "no longer current". WITHDRAWN means "was published, has been found
  /// wrong, and must stop being visible to students IMMEDIATELY" — while every grade and
  /// submission that references it stays valid, because a student's mark cannot be invalidated
  /// by the author fixing a typo afterwards.
  ///
  /// Collapsing WITHDRAWN into ARCHIVED would mean a correction either (a) stays visible to
  /// students, or (b) is hidden by archiving, which also breaks the version chain and every
  /// reference to it. Neither is acceptable, so the state exists and the discrepancy with
  /// plans/01 is recorded here rather than silently resolved.
  WITHDRAWN
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

model Resource {
  id         String         @id @default(uuid(7))
  tenantId   String?
  ownerId    String
  owner      User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  kind       ResourceKind   @default(LESSON)
  status     ResourceStatus @default(DRAFT)
  visibility Visibility     @default(PRIVATE)
  title      String
  slug       String
  summary    String?
  subjectId  String?
  subject    Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  currentVersionId String?          @unique
  currentVersion   ResourceVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt  DateTime? @db.Timestamptz(3)
  publishedAt DateTime? @db.Timestamptz(3)

  versions    ResourceVersion[] @relation("VersionChain")
  tags        ResourceTag[]
  assignments Assignment[]
  simRefs     ResourceSimRef[]
  ratings     Rating[]
  comments    Comment[]

  @@unique([ownerId, slug])
  @@index([kind, status, visibility, updatedAt])
  @@index([subjectId, kind, status])
  @@index([tenantId, status])
}

// INV-CONTENT-1: write-once. packages/db exposes createResourceVersion and NO content
// update path. A test asserts the update path does not exist.
model ResourceVersion {
  id         String   @id @default(uuid(7))
  resourceId String
  resource   Resource @relation("VersionChain", fields: [resourceId], references: [id], onDelete: Cascade)
  version    Int
  blocks        Json
  blocksChecksum String
  meta          Json
  // resolved, frozen assessment policy for this version
  assessmentPolicy Json?
  blueprintId     String?
  blueprint       Blueprint? @relation(fields: [blueprintId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  currentOf   Resource?  @relation("CurrentVersion")
  assignments Assignment[]
  questions   Question[]
  slots       AssessmentSlot[]
  simRefs     ResourceSimRef[]
  blueprintChecks BlueprintCheck[]

  @@unique([resourceId, version])
  @@index([resourceId, version])
  @@index([blueprintId])
}

model ResourceTag {
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
  @@index([tagId])
}

model ResourceSimRef {
  id         String   @id @default(uuid(7))
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  version    Int
  resourceVersionId String?
  resourceVersion   ResourceVersion? @relation(fields: [resourceVersionId], references: [id], onDelete: Cascade)
  blockId    String
  simId      String
  simVersion String

  @@unique([resourceId, version, blockId])
  @@index([simId, simVersion])
  @@index([resourceId, version])
}

// ─────────────────────────────────────────────────────────── question banks

model QuestionBank {
  id          String     @id @default(uuid(7))
  tenantId    String?
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name        String
  description String?
  visibility  Visibility @default(PRIVATE)
  sharedWithClassroomIds String[]
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  questions Question[]
  pools     QuestionPool[]

  @@index([ownerId])
  @@index([tenantId])
}

enum GradingMode {
  AUTO
  MANUAL
  HYBRID
}

// P-17: `cognitiveDemand` is a self-applied label with no inter-rater reliability, so it
// is OPTIONAL and display-only. The second blueprint axis is `responseProcess`, derived
// from the question type rather than authored. topic (KC) is the required tag.
enum ResponseProcess {
  RECOGNITION
  RECALL
  PRODUCTION
}

model Question {
  id         String       @id @default(uuid(7))
  tenantId   String?
  bankId     String
  bank       QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  type       String
  // INV-Q-1: this column is the answer key. Never projected to a student client.
  spec       Json
  points     Decimal      @default(1) @db.Decimal(9, 2)
  gradingMode GradingMode @default(AUTO)
  // P-19: partial-credit method, resolved and validated at publish. See QuestionPool.
  partialCreditMethod String?
  timeLimitSec Int?
  shuffleOptions Boolean  @default(false)
  estimatedSeconds Int?
  modelAnswer String?
  rubric     Json?
  language   String       @default("en-GB")
  revision   Int          @default(0)

  topic             String?
  cognitiveDemand   String? // optional, display-only, unvalidated
  responseProcess   ResponseProcess?

  // V-9: a practiceCheck in a public resource is a published answer key for any item
  // also used summatively. This flag blocks that at publish time.
  retiredFromSummativeUse Boolean @default(false)

  // simulation binding (INV-SIM-2)
  simId      String?
  simVersion String?
  simConfig  Json?
  // V-11: mandatory for any sim usable as a question. ENDPOINT_ONLY reads only the final
  // answer; PATH_SENSITIVE reads a bounded interaction trace. Without this the item
  // measures parameter-space search and its facility looks excellent.
  scoringSurface String?

  // ── version snapshots ────────────────────────────────────────────────────────────
  // B2: resourceVersionId was @unique, which permitted ONE snapshot per version and
  // made a pooled slot of 12 items impossible. Now indexed, not unique.
  // isSnapshot exists because snapshot rows also carry a non-null bankId; without it
  // every "how many items in this bank" query silently double-counts snapshots.
  isSnapshot        Boolean  @default(false)
  resourceVersionId String?
  resourceVersion   ResourceVersion? @relation(fields: [resourceVersionId], references: [id], onDelete: Cascade)
  snapshotOfId      String?
  snapshotOf        Question?  @relation("QuestionSnapshot", fields: [snapshotOfId], references: [id], onDelete: SetNull)
  snapshots         Question[] @relation("QuestionSnapshot")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  responses  QuestionResponse[]
  slots      AssessmentSlot[]
  poolItems  QuestionPoolItem[]
  tags       QuestionTag[]

  @@unique([resourceVersionId, snapshotOfId])
  @@index([resourceVersionId])
  @@index([bankId, type])
  @@index([bankId, isSnapshot])
  @@index([simId])
  @@index([snapshotOfId])
  @@index([topic])
  @@index([retiredFromSummativeUse])
}

model QuestionTag {
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId])
}

enum QuestionPoolStrategy {
  RANDOM_WITHOUT_REPLACEMENT
  QUOTA_TOPICS
  QUOTA_RESPONSE_PROCESS
  FIXED
}

model QuestionPool {
  id        String   @id @default(uuid(7))
  tenantId  String?
  bankId    String
  bank      QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  name      String
  strategy  QuestionPoolStrategy @default(RANDOM_WITHOUT_REPLACEMENT)
  drawCount Int      // N
  filter    Json?
  // P-14: the old warning referenced expectedCohortSize and targetOverlapTolerance,
  // neither of which existed anywhere. expectedCohortSize now exists; the undefined
  // tolerance is gone. The UI shows N/M, P(>=1 shared), P(identical pair) and expected
  // distinct items used by a cohort of this size.
  expectedCohortSize Int      @default(30)
  minDistinct        Int      @default(1)
  // V-3: a pool-level compatibility constraint so a detected dependent item pair cannot
  // co-occur in one form, which would otherwise be a source of random measurement error.
  incompatibleItemPairs Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  items    QuestionPoolItem[]
  slots    AssessmentSlot[]

  @@index([bankId])
  @@index([tenantId])
}

model QuestionPoolItem {
  poolId     String
  pool       QuestionPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  questionId String
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  weight     Int          @default(1)

  @@id([poolId, questionId])
  @@index([questionId])
}

model Blueprint {
  id          String   @id @default(uuid(7))
  tenantId    String?
  name        String
  description String?
  // matrix: [{ topic, responseProcess, points, tolerance }]
  matrix      Json
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  versions ResourceVersion[]
  checks   BlueprintCheck[]

  @@index([tenantId])
}

model BlueprintCheck {
  id                String   @id @default(uuid(7))
  blueprintId       String
  blueprint         Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  resourceVersionId String?
  resourceVersion   ResourceVersion? @relation(fields: [resourceVersionId], references: [id], onDelete: Cascade)
  // P-18: worst case is computed EXACTLY (bipartite b-matching / Hall's condition), not by
  // sampling, because a minimum over sampled draws is one-sided in the wrong direction and
  // would systematically understate how often a blueprint can fail.
  pass      Boolean
  blocksAllDraws Boolean @default(false)
  report    Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([blueprintId, createdAt])
}

// C7: assessmentSpec existed twice (a JSON column and these rows). The rows are truth.
model AssessmentSlot {
  id                String   @id @default(uuid(7))
  resourceVersionId String
  resourceVersion   ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Cascade)
  position          Int
  kind              String   // FIXED | POOLED
  questionId        String?
  question          Question? @relation(fields: [questionId], references: [id], onDelete: Restrict)
  poolId            String?
  pool              QuestionPool? @relation(fields: [poolId], references: [id], onDelete: Restrict)
  drawCount         Int?
  strategy          QuestionPoolStrategy?

  @@unique([resourceVersionId, position])
  @@index([poolId])
  @@index([questionId])
}

// ────────────────────────────────────────────────────── simulation registry

enum SimulationStatus {
  REGISTERED
  DEPRECATED
  DISABLED
}

model Simulation {
  // B1: @@unique([id, version]) is NOT an identifier. There was no primary key, so no
  // row identity, no FOR UPDATE, and every upsert needed the compound key.
  id      String
  version String

  status  SimulationStatus @default(REGISTERED)
  title       String
  description String
  subjects    String[]
  tags        String[]
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  manifest    Json
  bundlePath  String
  bundleSha256 String
  byteSize    Int
  // B14: graders run in a worker_thread with a memory cap and a timeout. This is the
  // entry the worker uses to resolve that thread, NOT an import path in the main loop.
  graderEntry String?
  capturesPath String?

  licence    String
  // D-24: `provenance` as a bare enum is licence laundering — an agent reproducing an
  // existing sim writes ORIGINAL because that is what passes. D-24 makes ORIGINAL
  // REQUIRE a `provenanceRef` into the provenance register, so laundering fails a build.
  provenance    String
  provenanceRef String?
  authors    String[]

  replacedById String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  retiredAt DateTime? @db.Timestamptz(3)

  attempts ExamAttempt[]

  @@id([id, version])
  @@index([status])
  @@index([subjects])
}

// ADR-0018: declarative only. No user code is ever executed.
model SimulationDraft {
  id        String   @id @default(uuid(7))
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  kind      String
  spec      Json
  compiled  Json?
  status    String   @default("DRAFT")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([authorId, status])
}

// ─────────────────────────────────────────────────────────────────── classroom

enum ClassroomRole {
  OWNER
  TEACHER
  REVIEWER // T-4: grading-only role, not roster, not integrity evidence. Lets a TA or a
            // departmental moderator be given the queue without full classroom access.
  STUDENT
}

enum EnrollmentStatus {
  ACTIVE
  REMOVED
  LEFT
}

model Classroom {
  id      String   @id @default(uuid(7))
  tenantId String?
  ownerId String
  owner   User     @relation("ClassroomOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name    String
  slug    String
  description String?
  archivedAt DateTime? @db.Timestamptz(3)
  // B5: deleting a classroom CASCADED away every grade, attempt and receipt, which
  // contradicted INV-CLASSROOM-2 and made the verifiable receipt unverifiable. Deletion is
  // now a DELETING window plus a PII-only purge; grade-bearing relations Restrict.
  deletingAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  enrollments    Enrollment[]
  invitations    ClassroomInvitation[]
  assignments    Assignment[]
  attempts       ExamAttempt[]
  releaseBatches ReleaseBatch[]
  rosterImports  RosterImport[]
  accommodations Accommodation[]
  reviewerGrants ReviewerGrant[]

  @@unique([ownerId, slug])
  @@index([tenantId, archivedAt])
}

model Enrollment {
  id          String           @id @default(uuid(7))
  classroomId String
  classroom   Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        ClassroomRole    @default(STUDENT)
  status      EnrollmentStatus @default(ACTIVE)
  displayNameOverride String?
  joinedAt    DateTime         @default(now()) @db.Timestamptz(3)
  endedAt     DateTime?        @db.Timestamptz(3)
  invitedById String?

  @@unique([classroomId, userId])
  @@index([userId, status])
  @@index([classroomId, role, status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model ClassroomInvitation {
  id          String           @id @default(uuid(7))
  tenantId    String?
  classroomId String
  classroom   Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  role        ClassroomRole    @default(STUDENT)
  email       String?          @db.Citext
  // B17: 6 characters from a 31-symbol alphabet is 8.8e8 and was grindable in about a day.
  // Codes are now 8 characters and DERIVED as HMAC(secret, classroomId || counter), so
  // verification is O(1) and revocation is a counter bump. Stored hashed regardless.
  codeHash    String?          @unique
  codeHint    String?
  // B17: a per-code failure counter, so a single code cannot be ground down.
  failedAttempts Int           @default(0)
  lockedAt    DateTime?        @db.Timestamptz(3)
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @db.Timestamptz(3)
  sentById    String
  sentBy      User             @relation("InviteSent", fields: [sentById], references: [id], onDelete: Restrict)
  acceptedById String?
  acceptedBy  User?            @relation("InviteAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt  DateTime?        @db.Timestamptz(3)
  resendCount Int              @default(0)
  lastSentAt  DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@index([classroomId, status])
  @@index([email, status])
}

model RosterImport {
  id          String   @id @default(uuid(7))
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  actorId     String
  filename    String
  dryRun      Boolean  @default(true)
  summary     Json
  errors      Json
  appliedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([classroomId, createdAt])
}

// T-4: a reviewer role scoped to grading, assignable to someone outside the classroom.
model ReviewerGrant {
  id          String   @id @default(uuid(7))
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       String   @default("GRADING") // GRADING | GRADING_AND_EVIDENCE
  grantedById String
  grantedAt   DateTime @default(now()) @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)

  @@unique([classroomId, userId])
  @@index([userId, revokedAt])
}

// ──────────────────────────────────────────────────────────────────── assignment

enum AssignmentMode {
  ASSIGNMENT
  EXAM
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

model Assignment {
  id          String           @id @default(uuid(7))
  tenantId    String?
  classroomId String
  classroom   Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  resourceId  String
  resource    Resource         @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  // INV-ASSIGN-1: the ONLY thing a student is assessed on.
  resourceVersionId String
  resourceVersion   ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)

  mode           AssignmentMode   @default(ASSIGNMENT)
  status         AssignmentStatus @default(DRAFT)
  titleOverride  String?
  instructions   Json?
  availableFrom  DateTime?        @db.Timestamptz(3)
  availableUntil DateTime?        @db.Timestamptz(3)
  maxAttempts    Int              @default(1)
  weight         Decimal          @default(100) @db.Decimal(9, 2)
  latePenaltyPercent Decimal       @default(0) @db.Decimal(5, 2)
  policyOverride Json?
  // T-1: the product promise is ATOMIC RELEASE, not 100% individual marking. A batch may
  // be moderated-and-sampled; sample size and moderation rule live here.
  moderationSampleSize Int         @default(0)
  moderationPercent   Int         @default(0)
  createdById    String
  createdBy      User             @relation("AssignmentAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  publishedAt    DateTime?        @db.Timestamptz(3)
  withdrawnAt    DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  attempts       ExamAttempt[]
  releaseBatches ReleaseBatch[]
  studentOverrides AssignmentStudentOverride[]
  accommodations Accommodation[]

  @@index([classroomId, status])
  @@index([status, availableFrom, availableUntil])
  @@index([tenantId, status])
}

model AssignmentStudentOverride {
  id           String   @id @default(uuid(7))
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  availableFrom  DateTime? @db.Timestamptz(3)
  availableUntil DateTime? @db.Timestamptz(3)
  maxAttempts   Int?
  // C13: extraTimePercent existed on BOTH this and Accommodation with no precedence. The
  // merge is now a documented fold; a mid-exam grant is computed from REMAINING time.
  extraTimePercent Decimal? @db.Decimal(5, 2)
  policyOverride Json?
  reason       String
  grantedById  String
  grantedBy    User     @relation("OverrideGrantor", fields: [grantedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

// ────────────────────────────────────────────────────── accommodations

// INV-ACC-1: a first-class auditable object, not a flag.
model Accommodation {
  id           String   @id @default(uuid(7))
  tenantId     String?
  classroomId  String
  classroom    Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId    String
  student      User     @relation("AccommodationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  // U-3: DISABLE_FULLSCREEN was missing entirely, so a screen-reader user could be forced
  // into fullscreen while the plan exempted Escape for pointer lock and then forgot the
  // equivalent. U-5: input, output and presentation accommodations, not just integrity.
  relaxations  String[]
  extraTimePercent Decimal? @db.Decimal(5, 2)
  reason       String
  status       String   @default("ACTIVE")
  grantedById  String
  grantedBy    User     @relation("AccommodationGrantor", fields: [grantedById], references: [id], onDelete: Restrict)
  grantedAt    DateTime @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime? @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)

  @@index([studentId, status])
  @@index([assignmentId])
  @@index([classroomId, status])
}

// U-4: the plan PROMISED students they would be told how to request an accommodation, and
// no such mechanism existed. The burden was entirely on the student.
model AccommodationRequest {
  id          String   @id @default(uuid(7))
  studentId   String
  student     User     @relation("RequestStudent", fields: [studentId], references: [id], onDelete: Cascade)
  classroomId String
  assignmentId String?
  requestedRelaxations String[]
  // U-4: "no accommodation requested" is itself an entitlement, so it is a first-class state.
  status      String   @default("REQUESTED") // REQUESTED | GRANTED | DENIED_WITH_REASON | WITHDRAWN
  statement   String?
  decidedById String?
  decidedBy   User?    @relation("RequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime? @db.Timestamptz(3)
  decisionReason String?
  // SLA, so a request cannot sit indefinitely
  respondBy   DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([status, respondBy])
  @@index([studentId, status])
  @@index([classroomId, status])
}

// ───────────────────────────────────────────────────────────────────── attempts

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  // V-12/C16: a student removed mid-exam needs a state to land in. Without it the held
  // answers sat forever ungraded and unreleasable.
  FROZEN
  SUBMITTED
  EXPIRED
  TERMINATED
  PENDING_REVIEW
  GRADED
  RELEASED
  EXCUSED
  VOIDED
}

enum AttemptSource {
  CLIENT
  CRON
  TEACHER
}

// V-7: a PRACTICE attempt consumed a graded attempt, because maxAttempts defaults to 1 and
// there was no purpose field. RN-04's practice run — called "the single cheapest reduction
// in exam-day technical failure" — was therefore unimplementable, and practice data would
// have silently contaminated every analytic query.
enum AttemptPurpose {
  PRACTICE
  GRADED
}

model ExamAttempt {
  id           String   @id @default(uuid(7))
  tenantId     String?
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  classroomId  String
  classroom    Classroom  @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  simId        String?
  simVersion   String?
  simulation   Simulation? @relation(fields: [simId, simVersion], references: [id, version], onDelete: Restrict)

  attemptNumber Int
  purpose       AttemptPurpose @default(GRADED)
  status        AttemptStatus  @default(NOT_STARTED)

  // C27: these were non-null, but an attempt is created NOT_STARTED and the snapshot is
  // taken at first start. Nullable, written by `UPDATE ... WHERE "policySnapshot" IS NULL`
  // so two concurrent starts cannot both write it.
  policySnapshot Json?
  rngSeed        String?
  variantMap     Json?
  variantSource  String  @default("VERSION")

  startedAt  DateTime? @db.Timestamptz(3)
  deadlineAt DateTime? @db.Timestamptz(3) // base deadline; NEVER updated (see extensions)
  gracePeriodSec Int     @default(60) // RN-04: Moodle's default
  // C15: BREAKS_ALLOWED was unimplementable — no field, and the deadline formula had no
  // pause term, so granting a break silently did nothing.
  pausedAccumSec  Int      @default(0)
  frozenAt        DateTime? @db.Timestamptz(3)
  frozenReason    String?
  submittedAt DateTime? @db.Timestamptz(3)
  submittedBy AttemptSource?
  submissionReceipt String?
  // C5: the receipt did not commit to the answer keys, so a mis-key was undetectable.
  // keysHash is folded into H0 and the final hash is HMAC'd with a KMS-held key.
  keysHash   String?
  isLate     Boolean @default(false)
  releasedAt DateTime? @db.Timestamptz(3)
  regradeNoticePendingAt DateTime? @db.Timestamptz(3)
  terminatedReason String?
  voidedReason     String?
  // U-9: sealed results with no SLA meant a student could be marked by a teacher's
  // silence indefinitely — a 90-minute exam waited a term.
  sealedEscalatedAt DateTime? @db.Timestamptz(3)

  // ── SEALED until a RELEASED ReleaseBatchMember row exists. INV-ATTEMPT-2 / INV-RELEASE-1
  autoScore   Decimal? @db.Decimal(9, 2)
  manualScore Decimal? @db.Decimal(9, 2)
  finalScore  Decimal? @db.Decimal(9, 2)
  maxScore    Decimal? @db.Decimal(9, 2)
  percentage  Decimal? @db.Decimal(6, 3)
  latePenaltyApplied Decimal? @db.Decimal(5, 2)

  accommodationId String?

  // B11: a single Int cannot represent five independent thresholds, and it silently
  // let a fullscreen-exit count trip the tab-hide threshold. See AttemptStrikeCounter.
  preflight    Json?
  // U-6: an inferred screen-reader status was persisted and retained for years, visible
  // in a teacher-facing report and invisible/uncorrectable to the student. Only
  // relaxationsApplied is kept now; the inference itself is transient.
  relaxationsApplied String[]
  // U-2: the count of DROPPED evidence events, so a teacher can see an escalation was
  // under-counted rather than trusting a counter the server was shedding from.
  droppedEventCount   Int      @default(0)
  clientInfo   Json?
  ipHash       String?
  userAgent    String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  responses        QuestionResponse[]
  sessions         AttemptSession[]
  events           AttemptEventRecord[]
  integrityEvents  IntegrityEvent[]
  answerRevisions  AnswerRevision[]
  reviewTasks      ReviewTask[]
  reviewAssignments ReviewAssignment[]
  feedback         Feedback[]
  gradeChanges     GradeChange[]
  verdict          IntegrityVerdict?
  extensions       AttemptDeadlineExtension[]
  strikes          AttemptStrikeCounter[]
  seqCounter       AttemptSeq?
  releaseMembers   ReleaseBatchMember[]
  simStateBlobs    SimStateBlob[]

  @@unique([assignmentId, studentId, attemptNumber, purpose])
  @@index([assignmentId, status])
  @@index([classroomId, studentId])
  @@index([status, deadlineAt])
  @@index([releasedAt])
  @@index([tenantId, status])
  @@index([simId, simVersion])
  @@index([status, sealedEscalatedAt])
}

enum AttemptEventType {
  STARTED
  RESUMED
  SAVED
  LATE_SAVE_REJECTED
  QUESTION_OPENED
  QUESTION_WINDOW_CLOSED
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
  AUTO_GRADED
  MANUAL_GRADED
  GRADED
  RELEASED
  REGRADED
  TERMINATED
  REINSTATED
  FROZEN
  VOIDED
  EXCUSED
  DEADLINE_EXTENDED
  PAUSED
  RESUMED_FROM_PAUSE
  POLICY_OVERRIDDEN
  ACCOMMODATION_APPLIED
  VIOLATION_THRESHOLD_REACHED
  SEAL_ESCALATED
}

// B1: this was `model AttemptEvent`, colliding with `enum AttemptEvent`. Renamed.
model AttemptEventRecord {
  id        BigInt   @id @default(autoincrement())
  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type      AttemptEventType
  actorId   String?
  serverTs  DateTime @default(now()) @db.Timestamptz(3)
  payload   Json

  @@index([attemptId, id])
  @@index([type, serverTs])
}

// C9: seq = max(existing)+1 is a hot-row serialisation point with no stated primitive.
model AttemptSeq {
  attemptId String @id
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  next      Int         @default(0)
}

// C14: EXTRA_TIME_PERCENT used to REWRITE deadlineAt, breaking INV-POLICY-1 and making
// verify-receipt report divergence on a legitimate action. Extensions are additive rows;
// deadlineAt is never updated. effectiveDeadline = deadlineAt + SUM(addedSec) + pausedAccumSec.
model AttemptDeadlineExtension {
  id        BigInt   @id @default(autoincrement())
  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  addedSec  Int
  reason    String
  actorId   String
  // T-6: a BULK, evidence-triggered extension operates on the event record, so one
  // student's connectivity collapse is one action rather than 300.
  triggerEventTypes String[]
  at        DateTime @default(now()) @db.Timestamptz(3)

  @@index([attemptId, id])
}

model AttemptSession {
  // B7: uuid(4), not uuid(7). This id was the sole credential for the sync endpoint and
  // time-ordered ids are enumerable.
  id         String   @id @default(uuid(4))
  attemptId  String
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  tabId      String?
  issuedAt   DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  revokedReason String?
  userAgent  String?
  ipHash     String?

  @@index([attemptId, revokedAt])
  @@index([expiresAt])
}

// B11: one counter per threshold KIND, incremented atomically. A single Int could not
// represent the five independent thresholds the policy defines.
model AttemptStrikeCounter {
  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  kind      String
  count     Int         @default(0)

  @@id([attemptId, kind])
}

// ───────────────────────────────────────────────────────────────────── responses

model QuestionResponse {
  id         String   @id @default(uuid(7))
  attemptId  String
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  position   Int      // position in the RESOLVED variant, not the authored order

  answer    Json
  // B15: simState is a POINTER. Oversize states live in S3 via SimStateBlob; a 64 KB cap
  // applies. An unbounded JSONB column on the primary was a disk-exhaustion amplifier.
  simStateRef String?
  simState    Json?
  simStateBytes Int?
  revision    Int @default(0)

  // V-4: omitted and non-reached responses were treated as WRONG, which on a timed exam
  // means the trailing items are blank because of the clock, not ignorance — and that
  // depresses facility and drives r_pb toward correlation with speed. The item analysis
  // then misdiagnoses a timing artefact as an item defect.
  isOmitted    Boolean @default(false)
  notReached   Boolean @default(false)
  isExcused    Boolean @default(false)
  // C12: attempt-level "submitted late" and response-level "written late" are different
  // facts with different uses. They were conflated on one column.
  isLate       Boolean @default(false)
  flagged      Boolean @default(false)
  timeSpentMs  Int?
  editCount    Int      @default(0)

  // B9: set by an explicit server-side OPEN transition, never by a write. Set-once via
  // COALESCE under a guard that it can never move forward. Without this an untouched
  // question never expired and LOCK/AUTO_SUBMIT never fired.
  questionOpenedAt   DateTime? @db.Timestamptz(3)
  questionDeadlineAt DateTime? @db.Timestamptz(3)
  questionClosedReason String?
  lastSavedAt        DateTime? @db.Timestamptz(3)
  saveState          String    @default("UNSAVED")

  // ── SEALED
  autoScore    Decimal? @db.Decimal(9, 2)
  // P-2/P-3: NG and PM produce negative RAW scores by design. The raw scale is preserved
  // here; the zero floor is applied in the attempt TOTAL only, and item statistics are
  // computed on the raw scale. Clamping at item level would silently convert NG into
  // "no penalty" and destroy the guessing suppression it exists to provide.
  autoRawScore Decimal? @db.Decimal(9, 2)
  autoCorrect  Boolean?
  autoGradedAt DateTime? @db.Timestamptz(3)
  autoRationale Json?
  autoGraderVersion String?

  manualScore    Decimal? @db.Decimal(9, 2)
  manualFeedback String?
  rubricScores   Json?
  // T-2: quick-scored responses are recorded as such and sampled for moderation, so a
  // teacher marking at 10s/script and one at 90s/script produce visibly different confidence.
  wasQuickScored  Boolean  @default(false)
  graderId       String?
  grader         User?     @relation("ResponseGrader", fields: [graderId], references: [id], onDelete: SetNull)
  gradedAt       DateTime? @db.Timestamptz(3)
  // V-6: needsHuman is EXCLUDED from statistics, never zeroed. Zeroing would penalise the
  // class for a platform bug, which INV-SIM-2 explicitly promises will not happen.
  needsHuman     Boolean  @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  revisions AnswerRevision[]
  feedback  Feedback[]

  @@unique([attemptId, questionId])
  @@index([attemptId, position])
  @@index([questionId, autoCorrect])
  @@index([needsHuman])
  @@index([isOmitted, notReached])
}

model SimStateBlob {
  id        String   @id @default(uuid(7))
  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  key       String
  byteSize  Int
  checksum  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([attemptId])
}

enum AnswerSource {
  CLIENT
  TEACHER
  GRADE
  SYSTEM
}

// B8: this table was the idempotency ledger AND recorded REJECTED writes, so a retry
// after a 409 returned a false 2xx SAVED and the student saw a green tick over an answer
// that was never stored. Rejections now go to AttemptEventRecord(LATE_SAVE_REJECTED).
// This table is a SUCCESS ledger only, and the original response bytes are stored so a
// replay returns the same body (C18: returning a recomputed revision desynchronised the
// client, causing every subsequent write to 409).
model AnswerRevision {
  id         BigInt   @id @default(autoincrement())
  responseId String
  response   QuestionResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  attemptId  String
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  revision   Int
  source     AnswerSource
  actorId    String?
  previousHash String?
  answerHash String
  // C5: hash the exact bytes accepted, not a re-read of jsonb (which does not preserve key
  // order or distinguish 1 from 1.0, so a re-read hash is not the hash of what was sent).
  answerBytes String?
  serverTs   DateTime @default(now()) @db.Timestamptz(3)
  clientTs   DateTime? @db.Timestamptz(3)
  idemKey    String?
  // the ORIGINAL response, replayed verbatim on a duplicate idemKey
  responseStatus Int?
  responseBody   Json?

  @@unique([responseId, revision])
  @@unique([attemptId, idemKey])
  @@index([attemptId, revision])
}

// ───────────────────────────────────────────────────────────────────── grading

enum ReviewTaskStatus {
  PENDING
  CLAIMED
  DONE
}

model ReviewTask {
  id        String   @id @default(uuid(7))
  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  graderId  String?
  grader    User?    @relation("ReviewClaimer", fields: [graderId], references: [id], onDelete: SetNull)
  status    ReviewTaskStatus @default(PENDING)
  claimedAt DateTime? @db.Timestamptz(3)
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([attemptId])
  @@index([status, priority, createdAt])
  @@index([graderId, status])
}

// T-3: no inter-rater reliability existed for the component that is 100% of the product's
// work. 10-20% of every release batch is double-marked; agreement is reported per rubric;
// a rubric whose bands disagree between two teachers is a RUBRIC defect.
model ReviewAssignment {
  id          String   @id @default(uuid(7))
  attemptId   String
  attempt     ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  responseId  String?
  assigneeId  String
  assignee    User     @relation("ReviewAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  isSecondMarker Boolean @default(false)
  status      String   @default("ASSIGNED") // ASSIGNED | DONE | RELEASED
  assignedById String
  assignedAt  DateTime @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  @@unique([attemptId, responseId, assigneeId])
  @@index([assigneeId, status])
  @@index([attemptId])
}

enum ReleaseBatchStatus {
  DRAFT
  READY
  RELEASING
  RELEASED
  CANCELED
}

model ReleaseBatch {
  id           String   @id @default(uuid(7))
  tenantId     String?
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  classroomId  String
  classroom    Classroom  @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  label        String?
  status       ReleaseBatchStatus @default(DRAFT)
  // K-4/RN-03: a minimum pre-release review window. Previously claimed in the research
  // notes and implemented nowhere.
  minHoldUntil DateTime? @db.Timestamptz(3)
  overrideReason String?
  releasedById String?
  releasedBy   User?     @relation(fields: [releasedById], references: [id], onDelete: SetNull)
  releasedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  // B16: `membership Json` was a 190 KB TOASTed array of up to 5,000 UUIDs, rewritten on
  // every change and unqueryable in Prisma without raw SQL. It is now real rows, and it
  // is the whole mechanism: student visibility is EXISTS(... batch status = 'RELEASED').
  members      ReleaseBatchMember[]

  @@index([assignmentId, status])
  @@index([classroomId, status])
  @@index([tenantId, status])
  @@index([status, minHoldUntil])
}

model ReleaseBatchMember {
  batchId   String
  batch     ReleaseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  addedAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@id([batchId, attemptId])
  @@index([attemptId])
}

enum FeedbackVisibility {
  TEACHER_ONLY
  STUDENT_AFTER_RELEASE
}

model Feedback {
  id         String   @id @default(uuid(7))
  attemptId  String
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  responseId String?
  response   QuestionResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body       String
  visibility FeedbackVisibility @default(STUDENT_AFTER_RELEASE)
  isDraft    Boolean  @default(false)
  // U-12: a mis-key after release, disputed by students. Surfaced on the item report with
  // an SLA, and blocks final reporting for that item.
  disputedByCount Int @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([attemptId, visibility])
  @@index([responseId, disputedByCount])
}

model GradeChange {
  id         String   @id @default(uuid(7))
  responseId String?
  attemptId  String
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  actorId    String
  before     Json
  after      Json
  reason     String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([attemptId, createdAt])
  @@index([responseId])
}

// ────────────────────────────────────────────────────────── integrity evidence

enum EventSeverity {
  INFO
  WARN
  VIOLATION
}

model IntegrityEvent {
  id         BigInt   @id @default(autoincrement())
  attemptId  String
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sessionId  String?
  // C8: the CLIENT sends clientSeq; the SERVER assigns seq. Idempotency is on
  // (attemptId, sessionId, clientSeq). Conflating the two made replay undetectable.
  clientSeq  Int?
  seq        Int?
  type       String
  severity   EventSeverity @default(INFO)
  serverTs   DateTime @default(now()) @db.Timestamptz(3)
  // C8: serverTs is transaction_timestamp(), so every event in one batch shares a stamp.
  // A batch queued in IndexedDB for 10 minutes had every clientTs clamped and the
  // teacher's timeline was wrong. receivedAt is explicit.
  receivedAt DateTime? @db.Timestamptz(3)
  clientTs   DateTime? @db.Timestamptz(3)
  // INV-TELEMETRY-2: closed schema, allowlisted keys, no content, no PII
  payload    Json
  receivedBy String?
  dropped    Boolean  @default(false)
  accommodationRelaxed Boolean @default(false)
  // U-2: threshold-crossing and above-threshold events are NEVER dropped
  protected   Boolean  @default(false)

  @@unique([attemptId, sessionId, clientSeq])
  @@index([attemptId, seq])
  @@index([attemptId, severity, serverTs])
  @@index([type, serverTs])
  @@index([protected, dropped])
}

// The human disposition of an attempt's evidence. The machine may recommend; only a human
// disposes. V-14: cluster membership alone can never be a factor without a noted context.
model IntegrityVerdict {
  id         String   @id @default(uuid(7))
  attemptId  String   @unique
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  outcome    String   // NO_CONCERN | NOTED | REVIEW | VOIDED
  reason     String
  // U-6: an inferred disability status must never be a hidden, durable teacher-visible field
  consideredAccessibilityContext Boolean @default(false)
  decidedById String
  decidedBy  User     @relation(fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt  DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([outcome, decidedAt])
}

// ───────────────────────────────────────────────────────── platform concerns

model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  classroomId String?
  meta       Json
  ipHash     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([classroomId, createdAt])
}

model Notification {
  id        String   @id @default(uuid(7))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String
  href      String?
  data      Json?
  readAt    DateTime? @db.Timestamptz(3)
  emailedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt, createdAt])
}

model Asset {
  id          String   @id @default(uuid(7))
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind        String   // IMAGE | VIDEO | SUBMISSION | EXPORT
  key         String   @unique
  contentType String
  byteSize    Int
  width       Int?
  height      Int?
  altText     String?
  checksum    String
  // D-12: the scan adapter lands with the media library (P2-T6), not 7 phases later.
  scanStatus  String   @default("PENDING") // PENDING | CLEAN | INFECTED | ERROR
  scannedAt   DateTime? @db.Timestamptz(3)
  status      String   @default("READY")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([ownerId, kind])
  @@index([scanStatus])
}

model Rating {
  id         String   @id @default(uuid(7))
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value      Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([resourceId, userId])
}

model Comment {
  id         String   @id @default(uuid(7))
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  status     String   @default("VISIBLE")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([resourceId, status, createdAt])
}

model IdempotencyKey {
  key         String   @id
  scope       String
  requestHash String
  response    Json?
  status      String   @default("IN_PROGRESS")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)

  @@index([scope, createdAt])
  @@index([expiresAt])
}

model EmailOutbox {
  id          String   @id @default(uuid(7))
  toEmail     String   @db.Citext
  template    String
  payload     Json
  dedupeKey   String   @unique
  status      String   @default("QUEUED")
  attempts    Int      @default(0)
  lastError   String?
  scheduledAt DateTime @default(now()) @db.Timestamptz(3)
  sentAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([status, scheduledAt])
}

// Never the source of truth — a denormalised list view only.
model AssignmentCounter {
  assignmentId  String @id
  total         Int    @default(0)
  started       Int    @default(0)
  submitted     Int    @default(0)
  pendingReview Int    @default(0)
  released      Int    @default(0)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
}

// ───────────────────────────────────────────────────────────── interop

// B13: QTI export is a key-exfiltration surface. Every write to this table for kind
// QTI_ASSESSMENT is an audited event naming the item ids.
model ExternalBinding {
  id          String   @id @default(uuid(7))
  tenantId    String?
  kind        String   // QTI_ASSESSMENT | ONEROSTER_CLASS | ONEROSTER_USER | LTI_PLATFORM
  externalId  String
  localType   String
  localId     String
  direction   String   // IMPORT | EXPORT | BIDIRECTIONAL
  lastSyncedAt DateTime? @db.Timestamptz(3)
  lastHash    String?
  meta        Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([kind, externalId, localType, localId])
  @@index([localType, localId])
  @@index([tenantId])
}
