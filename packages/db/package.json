{
  "name": "@orrery/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sessions": {
      "types": "./dist/sessions.d.ts",
      "default": "./dist/sessions.js"
    },
    "./deletion": {
      "types": "./dist/deletion.d.ts",
      "default": "./dist/deletion.js"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "default": "./dist/resources.js"
    },
    "./library": {
      "types": "./dist/library.d.ts",
      "default": "./dist/library.js"
    },
    "./resource-version": {
      "types": "./dist/resource-version.d.ts",
      "default": "./dist/resource-version.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:diff": "node ../../scripts/schema-gate.mjs",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@orrery/clock": "workspace:*",
    "@orrery/auth": "workspace:*",
    "@prisma/client": "6.19.3",
    "@orrery/contracts": "workspace:*"
  },
  "devDependencies": {
    "@node-rs/argon2": "2.0.2",
    "vitest": "3.2.7",
    "@vitest/coverage-v8": "3.2.7"
  },
  "peerDependencies": {
    "@node-rs/argon2": "^2"
  }
}
