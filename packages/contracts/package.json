{
  "name": "@orrery/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "default": "./dist/blocks/index.js"
    },
    "./blocks/providers": {
      "types": "./dist/blocks/providers.d.ts",
      "default": "./dist/blocks/providers.js"
    },
    "./blocks/migrate": {
      "types": "./dist/blocks/migrate.d.ts",
      "default": "./dist/blocks/migrate.js"
    },
    "./blocks/fixtures": {
      "types": "./dist/blocks/fixtures.d.ts",
      "default": "./dist/blocks/fixtures.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "default": "./dist/render/index.js"
    },
    "./render/escape": {
      "types": "./dist/render/escape.d.ts",
      "default": "./dist/render/escape.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle/index.d.ts",
      "default": "./dist/lifecycle/index.js"
    },
    "./publish": {
      "types": "./dist/publish/index.d.ts",
      "default": "./dist/publish/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo coverage"
  },
  "dependencies": {
    "katex": "0.16.22",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/node": "22.10.2",
    "jest-axe": "10.0.0",
    "jsdom": "26.1.0",
    "vitest": "3.2.7"
  }
}
