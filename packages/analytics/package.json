{
  "name": "@orrery/analytics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rollups": {
      "types": "./dist/rollups.d.ts",
      "default": "./dist/rollups.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "fast-check": "3.23.2"
  },
  "dependencies": {
    "@orrery/clock": "workspace:*",
    "@orrery/contracts": "workspace:*"
  }
}
