{
  "name": "@orrery/exam-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./evidence": {
      "types": "./dist/evidence.d.ts",
      "default": "./dist/evidence.js"
    },
    "./accommodations": {
      "types": "./dist/accommodations.d.ts",
      "default": "./dist/accommodations.js"
    },
    "./deadlines": {
      "types": "./dist/deadlines.d.ts",
      "default": "./dist/deadlines.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@orrery/clock": "workspace:*",
    "@orrery/contracts": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "3.23.2",
    "@orrery/interop": "workspace:*"
  }
}
