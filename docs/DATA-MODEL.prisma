// Orrery — draft data model (P0-T4 starting point, expected to be revised during P1/P2/P6)
//
// Conventions
//   • IDs: String @id @default(uuid(7)) — time-ordered, generated by Postgres.
//   • Money/points: Decimal(9,2). Never Float.
//   • Instants: DateTime @db.Timestamptz(3). All in UTC. Rendering is the client's problem.
//   • Every user-visible mutation writes an AuditEvent in the same transaction.
//   • Enums live in Postgres (not TS) so the DB can enforce them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────── identity

model User {
  id            String    @id @default(uuid(7))
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String
  avatarUrl     String?
  status        UserStatus @default(ACTIVE)
  locale        String    @default("en")
  timezone      String    @default("UTC")

  // account deletion
  deletingAt      DateTime?
  deletedAt       DateTime?
  anonymisedAt    DateTime?
  // abuse controls
  suspendedReason String?
  lastLoginAt     DateTime?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  accounts            Account[]
  sessions            Session[]
  verificationTokens  VerificationToken[]
  ownedResources      Resource[]
  resourceVersions    ResourceVersion[]
  classroomsOwned     Classroom[]           @relation("ClassroomOwner")
  enrollments         Enrollment[]
  invitationsSent     ClassroomInvitation[] @relation("InvitationSent")
  invitationsAccepted ClassroomInvitation[] @relation("InvitationAccepted")
  assignmentsCreated  Assignment[]          @relation("AssignmentAuthor")
  attempts            ExamAttempt[]
  responsesGraded     QuestionResponse[]    @relation("ResponseGrader")
  reviewTasks         ReviewTask[]
  releaseBatches      ReleaseBatch[]
  feedbackAuthored    Feedback[]
  auditEvents         AuditEvent[]
  notifications       Notification[]
  simUploads          SimulationDraft[]

  @@index([status, createdAt])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETING
  DELETED
}

// Better Auth tables. Names follow its schema expectations; do not rename casually.
model Account {
  id                    String   @id @default(uuid(7))
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid(7))
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime @db.Timestamptz(3)
  ipHash       String?
  userAgent    String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  revokedAt    DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model VerificationToken {
  id         String   @id @default(uuid(7))
  identifier String
  token      String   @unique
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([identifier])
}

// ───────────────────────────────────────────────────────────── taxonomy

model Subject {
  id          String  @id @default(uuid(7))
  slug        String  @unique
  name        String
  description String?
  colour      String?
  position    Int     @default(0)
  parentId    String?
  parent      Subject?  @relation("SubjectTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Subject[] @relation("SubjectTree")

  resources        Resource[]
  sims             Simulation[]

  @@index([parentId, position])
}

model Tag {
  id        String   @id @default(uuid(7))
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  resources ResourceTag[]
}

// ───────────────────────────────────────────────────────────── content

enum ResourceKind {
  LESSON
  QUIZ
  EXAM
}

enum ResourceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

model Resource {
  id            String         @id @default(uuid(7))
  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  kind          ResourceKind   @default(LESSON)
  status        ResourceStatus @default(DRAFT)
  visibility    Visibility     @default(PRIVATE)
  title         String
  slug          String
  summary       String?
  subjectId     String?
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  // head of the version chain
  currentVersionId String?          @unique
  currentVersion   ResourceVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  archivedAt DateTime?

  versions ResourceVersion[] @relation("VersionChain")
  tags     ResourceTag[]
  assignments Assignment[]
  usedInBlocks ResourceBlockRef[]
  ratings  Rating[]
  comments Comment[]

  @@unique([ownerId, slug])
  @@index([kind, status, visibility, updatedAt])
  @@index([subjectId, kind, status])
}

model ResourceVersion {
  id         String   @id @default(uuid(7))
  resourceId String
  resource   Resource @relation("VersionChain", fields: [resourceId], references: [id], onDelete: Cascade)
  version    Int
  // ── INV-CONTENT-1: everything below is write-once. No update path exists in @orrery/db.
  // This extends to `Question` rows: questions belong to a version and are created with
  // it, so a practice check inside v1 keeps referring to v1's question forever.
  blocks        Json
  blocksChecksum String
  meta          Json
  assessmentPolicy  Json?
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  currentOf    Resource?  @relation("CurrentVersion")
  assignments  Assignment[]
  questions    Question[]

  @@unique([resourceId, version])
  @@index([resourceId, version])
}

// denormalised index of simulations referenced by a version, for publish validation
// and for "which resources use this sim" impact analysis
model ResourceBlockRef {
  id         String   @id @default(uuid(7))
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  version    Int
  blockId    String
  simId      String
  simVersion String

  @@unique([resourceId, version, blockId])
  @@index([simId])
}

// ───────────────────────────────────────────────────── simulation registry

enum SimulationStatus {
  REGISTERED
  DEPRECATED
  DISABLED
}

model Simulation {
  // natural key
  id      String
  version String
  status  SimulationStatus @default(REGISTERED)

  title       String
  description String
  subjects    String[]
  tags        String[]
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  manifest   Json
  bundlePath String
  bundleSha256 String
  byteSize   Int
  graderEntry String? // module path exporting grader(state) -> grade
  capturesPath String? // auto-captured screenshots from the conformance run

  licence    String
  provenance String // ORIGINAL | INSPIRED_BY:<ref> | PORTED
  authors    String[]

  replacedById String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  retiredAt DateTime?

  @@unique([id, version])
  @@index([id, status])
  @@index([subjects])
}

// declarative sims authored in Sim Studio (P6-T12). No user code is ever executed.
model SimulationDraft {
  id         String   @id @default(uuid(7))
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title      String
  spec       Json
  compiled   Json?
  status     String   @default("DRAFT")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([authorId, status])
}

// ───────────────────────────────────────────────────────────── classroom

enum ClassroomRole {
  OWNER
  TEACHER
  STUDENT
}

enum EnrollmentStatus {
  ACTIVE
  REMOVED
  LEFT
}

model Classroom {
  id      String   @id @default(uuid(7))
  ownerId String
  owner   User     @relation("ClassroomOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name    String
  slug    String
  description String?
  archivedAt DateTime?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  enrollments  Enrollment[]
  invitations  ClassroomInvitation[]
  assignments  Assignment[]
  attempts     ExamAttempt[]
  releaseBatches ReleaseBatch[]
  rosterImports RosterImport[]

  @@unique([ownerId, slug])
  @@index([archivedAt])
}

model Enrollment {
  id          String           @id @default(uuid(7))
  classroomId String
  classroom   Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        ClassroomRole    @default(STUDENT)
  status      EnrollmentStatus @default(ACTIVE)
  displayNameOverride String?
  joinedAt    DateTime         @default(now()) @db.Timestamptz(3)
  endedAt     DateTime?
  invitedById String?

  @@unique([classroomId, userId])
  @@index([userId, status])
  @@index([classroomId, role, status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model ClassroomInvitation {
  id          String           @id @default(uuid(7))
  classroomId String
  classroom   Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  role        ClassroomRole    @default(STUDENT)
  email       String?
  codeHash    String?          @unique
  codeHint    String?          // last 2 chars, for the teacher's printed copy
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @db.Timestamptz(3)
  sentById    String
  sentBy      User             @relation("InvitationSent", fields: [sentById], references: [id], onDelete: Restrict)
  acceptedById String?
  acceptedBy  User?            @relation("InvitationAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt  DateTime?
  resendCount Int              @default(0)
  lastSentAt  DateTime?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@index([classroomId, status])
  @@index([email, status])
}

model RosterImport {
  id          String   @id @default(uuid(7))
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  actorId     String
  filename    String
  dryRun      Boolean  @default(true)
  summary     Json
  errors      Json
  appliedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([classroomId, createdAt])
}

// ───────────────────────────────────────────────────────────── assignment

enum AssignmentMode {
  ASSIGNMENT
  EXAM
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

model Assignment {
  id         String         @id @default(uuid(7))
  classroomId String
  classroom  Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource       @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  // ── INV-ASSIGN-1: this pinned version is the only thing a student is assessed on.
  resourceVersionId String
  resourceVersion   ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)

  mode           AssignmentMode   @default(ASSIGNMENT)
  status         AssignmentStatus @default(DRAFT)
  titleOverride  String?
  instructions   Json?
  availableFrom  DateTime?        @db.Timestamptz(3)
  availableUntil DateTime?        @db.Timestamptz(3)
  maxAttempts    Int              @default(1)
  weight         Decimal          @default(100) @db.Decimal(9, 2)
  latePenaltyPercent Decimal       @default(0) @db.Decimal(5, 2)
  policyOverride Json?
  createdById    String
  createdBy      User             @relation("AssignmentAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  publishedAt    DateTime?
  withdrawnAt    DateTime?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  attempts       ExamAttempt[]
  releaseBatches ReleaseBatch[]

  @@index([classroomId, status])
  @@index([status, availableFrom, availableUntil])
}

// ───────────────────────────────────────────────────────────── attempts

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  TERMINATED
  PENDING_REVIEW
  GRADED
  RELEASED
  EXCUSED
  VOIDED
}

enum AttemptSource {
  CLIENT
  CRON
  TEACHER
}

model ExamAttempt {
  id           String         @id @default(uuid(7))
  assignmentId String
  assignment   Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  classroomId  String
  classroom    Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId    String
  student      User           @relation(fields: [studentId], references: [id], onDelete: Restrict)

  attemptNumber Int
  status        AttemptStatus @default(NOT_STARTED)

  // ── frozen at first start; later policy edits never affect this attempt
  policySnapshot Json
  // per-student determinism: seed + variant assignment for every question
  rngSeed        String
  variantMap     Json

  startedAt        DateTime? @db.Timestamptz(3)
  deadlineAt       DateTime? @db.Timestamptz(3)
  gracePeriodSec   Int       @default(0)
  submittedAt      DateTime? @db.Timestamptz(3)
  submittedBy      AttemptSource?
  submissionReceipt String?
  isLate           Boolean  @default(false)
  releasedAt       DateTime? @db.Timestamptz(3)
  regradeNoticePendingAt DateTime? @db.Timestamptz(3)
  terminatedReason String?
  voidedReason     String?

  // SEALED until releaseBatchId is set. See INV-ATTEMPT-2 / INV-RELEASE-1.
  autoScore     Decimal? @db.Decimal(9, 2)
  manualScore   Decimal? @db.Decimal(9, 2)
  finalScore    Decimal? @db.Decimal(9, 2)
  maxScore      Decimal? @db.Decimal(9, 2)
  percentage    Decimal? @db.Decimal(6, 3)
  latePenaltyApplied Decimal? @db.Decimal(5, 2)

  // accommodations: a granted, recorded relaxation — never a violation
  accommodations Json?
  accommodationsGrantedById String?

  strikeCount   Int       @default(0)
  preflight     Json?
  ipHash        String?
  userAgent     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  responses      QuestionResponse[]
  sessions       AttemptSession[]
  integrityEvents IntegrityEvent[]
  answerRevisions AnswerRevision[]
  reviewTasks    ReviewTask[]
  feedback       Feedback[]
  releaseBatch   ReleaseBatch? @relation(fields: [releaseBatchId], references: [id], onDelete: SetNull)
  releaseBatchId String?
  events         AttemptEvent[]

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([assignmentId, status])
  @@index([classroomId, studentId])
  @@index([status, deadlineAt])
  @@index([releaseBatchId])
}

enum AttemptEvent {
  STARTED
  RESUMED
  SAVED
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
  AUTO_GRADED
  MANUAL_GRADED
  RELEASED
  REGRADED
  TERMINATED
  VOIDED
  EXCUSED
  DEADLINE_EXTENDED
  POLICY_OVERRIDDEN
  ACCOMMODATION_APPLIED
}

// an append-only narrative of everything that happened, for teacher review and disputes
model AttemptEvent {
  id        BigInt   @id @default(autoincrement())
  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type      AttemptEvent
  actorId   String?
  serverTs  DateTime @default(now()) @db.Timestamptz(3)
  payload   Json

  @@index([attemptId, id])
}

model AttemptSession {
  id         String   @id @default(uuid(7))
  attemptId  String
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  issuedAt   DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime?
  revokedReason String?
  userAgent  String?
  ipHash     String?
  // client-generated per-tab id, used only to detect concurrent tabs
  tabId      String?

  @@index([attemptId, revokedAt])
  @@index([expiresAt])
}

// ───────────────────────────────────────────────────────────── responses

enum GradingMode {
  AUTO
  MANUAL
  HYBRID
}

model QuestionResponse {
  id         String   @id @default(uuid(7))
  attemptId  String
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Restrict)
  position   Int

  answer      Json
  simState    Json?     // serialised sim state; the sole input to a sim auto-grade
  revision    Int       @default(0)
  isExcused   Boolean   @default(false)
  flagged     Boolean   @default(false)
  timeSpentMs Int?
  editCount   Int       @default(0)

  // per-question timing, set server-side on first accepted interaction
  questionOpenedAt   DateTime? @db.Timestamptz(3)
  questionDeadlineAt DateTime? @db.Timestamptz(3)
  questionClosedReason String?
  lastSavedAt        DateTime? @db.Timestamptz(3)
  saveState          String   @default("UNSAVED")

  // SEALED
  autoScore      Decimal? @db.Decimal(9, 2)
  autoCorrect    Boolean?
  autoGradedAt   DateTime? @db.Timestamptz(3)
  autoRationale  Json?      // teacher-only explanation of the auto-grade
  autoGraderVersion String?

  // teacher
  manualScore    Decimal? @db.Decimal(9, 2)
  manualFeedback String?
  rubricScores   Json?
  graderId       String?
  grader         User?     @relation("ResponseGrader", fields: [graderId], references: [id], onDelete: SetNull)
  gradedAt       DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  revisions AnswerRevision[]
  feedback  Feedback[]

  @@unique([attemptId, questionId])
  @@index([attemptId, position])
  @@index([questionId, autoCorrect])
}

enum AnswerSource {
  CLIENT
  TEACHER
  GRADE
  SYSTEM
}

// append-only; the chain is what makes a submission receipt verifiable
model AnswerRevision {
  id          BigInt   @id @default(autoincrement())
  responseId  String
  response    QuestionResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  attemptId   String
  attempt     ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  revision    Int
  source      AnswerSource
  actorId     String?
  previousHash String?
  answerHash   String
  serverTs    DateTime @default(now()) @db.Timestamptz(3)
  clientTs    DateTime? @db.Timestamptz(3)
  idemKey     String?
  accepted    Boolean  @default(true)
  rejectReason String?

  @@unique([responseId, revision])
  @@unique([attemptId, idemKey])
  @@index([attemptId, revision])
}

model Question {
  id           String   @id @default(uuid(7))
  resourceVersionId String
  resourceVersion ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Cascade)
  position     Int
  type         String
  // ── INV-Q-1: this column is the answer key. It is never projected to a student client.
  spec         Json
  points       Decimal  @db.Decimal(9, 2)
  gradingMode  GradingMode @default(AUTO)
  timeLimitSec Int?
  shuffle      Boolean  @default(false)
  // simulation binding
  simId        String?
  simVersion   String?
  simConfig    Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  responses QuestionResponse[]

  @@unique([resourceVersionId, position])
  @@index([simId])
}

// ───────────────────────────────────────────────────────────── grading

enum ReviewTaskStatus {
  PENDING
  CLAIMED
  DONE
}

model ReviewTask {
  id        String   @id @default(uuid(7))
  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  graderId  String?
  grader    User?    @relation(fields: [graderId], references: [id], onDelete: SetNull)
  status    ReviewTaskStatus @default(PENDING)
  claimedAt DateTime? @db.Timestamptz(3)
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([attemptId])
  @@index([status, priority, createdAt])
  @@index([graderId, status])
}

enum ReleaseBatchStatus {
  DRAFT
  READY
  RELEASING
  RELEASED
  CANCELED
}

model ReleaseBatch {
  id           String   @id @default(uuid(7))
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  classroomId  String
  classroom    Classroom  @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  label        String?
  status       ReleaseBatchStatus @default(DRAFT)
  membership   Json     // frozen array of attemptIds once status enters RELEASING
  overrideReason String?
  releasedById String?
  releasedBy   User?    @relation(fields: [releasedById], references: [id], onDelete: SetNull)
  releasedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  attempts ExamAttempt[]

  @@index([assignmentId, status])
  @@index([classroomId, status])
}

enum FeedbackVisibility {
  TEACHER_ONLY
  STUDENT_AFTER_RELEASE
}

model Feedback {
  id         String   @id @default(uuid(7))
  attemptId  String
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  responseId String?
  response   QuestionResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body       String
  visibility FeedbackVisibility @default(STUDENT_AFTER_RELEASE)
  isDraft    Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([attemptId, visibility])
}

model GradeChange {
  id         String   @id @default(uuid(7))
  responseId String?
  attemptId  String
  actorId    String
  before     Json
  after      Json
  reason     String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([attemptId, createdAt])
  @@index([responseId])
}

// ───────────────────────────────────────────────────── integrity telemetry

enum EventSeverity {
  INFO
  WARN
  VIOLATION
}

model IntegrityEvent {
  id         BigInt   @id @default(autoincrement())
  attemptId  String
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sessionId  String?
  seq        Int
  type       String
  severity   EventSeverity @default(INFO)
  clientTs   DateTime? @db.Timestamptz(3)
  serverTs   DateTime  @default(now()) @db.Timestamptz(3)
  // ── INV-TELEMETRY-2: closed schema, allowlisted keys, no content, no PII
  payload    Json
  receivedBy String?
  dropped    Boolean  @default(false)

  @@unique([attemptId, seq])
  @@index([attemptId, severity, serverTs])
  @@index([type, serverTs])
}

// ───────────────────────────────────────────────────── platform concerns

model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  classroomId String?
  meta       Json
  ipHash     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model Notification {
  id        String   @id @default(uuid(7))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String
  href      String?
  data      Json?
  readAt    DateTime? @db.Timestamptz(3)
  emailedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt, createdAt])
}

model Asset {
  id          String   @id @default(uuid(7))
  ownerId     String
  kind        String
  key         String   @unique
  contentType String
  byteSize    Int
  width       Int?
  height      Int?
  altText     String?
  checksum    String
  status      String   @default("READY")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([ownerId, kind])
}

model Rating {
  id         String   @id @default(uuid(7))
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  value      Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([resourceId, userId])
}

model Comment {
  id         String   @id @default(uuid(7))
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  authorId   String
  body       String
  status     String   @default("VISIBLE")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([resourceId, status, createdAt])
}

model ResourceTag {
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
  @@index([tagId])
}

// idempotency for every state-changing external call (email, sim build, release)
model IdempotencyKey {
  key        String   @id
  scope      String
  requestHash String
  response   Json?
  status     String   @default("IN_PROGRESS")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)

  @@index([scope, createdAt])
  @@index([expiresAt])
}

// denormalised counters for list views; never the source of truth
model AssignmentCounter {
  assignmentId String @id
  total        Int    @default(0)
  started      Int    @default(0)
  submitted    Int    @default(0)
  pendingReview Int   @default(0)
  released     Int    @default(0)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}
