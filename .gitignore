node_modules/
.pnpm-store/
.turbo/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

.env
.env.*
!.env.example
# Committed deliberately: it contains NO secrets (the same local-development credentials as
# .env.example and as plans/), only the host ports moved off the defaults, because 5432 and
# 6379 are frequently already taken on a developer machine. Excluding it would make the test
# setup unreproducible for anyone but the person who wrote it.
!.env.test
*.pem
*.key

.worktrees/
.local/
.tmp/
# …except the tracker. It lives here because it is the project's execution record, and it was
# LOST once already when the workspace moved between hosts: an untracked file in a scratch
# directory survives nothing. Durable history belongs in the repository, not in `/tmp`.
!.tmp/TRACKER.md
tmp/

playwright-report/
test-results/
blob-report/
.playwright/

.DS_Store
*.log
npm-debug.log*
pnpm-debug.log*

.idea/
.vscode/*
!.vscode/extensions.json

# Prisma generated client. Regenerated by `pnpm db:generate`; never hand-edited and
# never committed, because a committed generated client is a merge-conflict magnet.
packages/db/prisma/generated/

# Simulation bundles are BUILD OUTPUT: content-hashed, regenerated by `pnpm sim:build`, and verified
# by `pnpm sim:check` in CI. Committing them would put a hash in git that a rebuild can invalidate, and
# a stale committed bundle is a bundle that can be served. `registry-entry.json` is ignored with them.
sims/*/dist/
# The registry is regenerated by `pnpm sim:build` and verified by `pnpm sim:check`. Committing it
# would put a digest in git that a rebuild can invalidate, and a committed registry is a registry a
# human edited.
sims/registry/

# P12-T5 screenshot capture. BOTH the PNGs and the generated `.host.html` scaffolding are build output:
# the capture writes one host page per simulation, and biome was linting 30 generated HTML files as if
# they were source. Regenerate with `pnpm sim:screenshots`.
sims/screenshots/
