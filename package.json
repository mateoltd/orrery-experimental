{
  "name": "orrery",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint . --fix",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "audit:deps": "osv-scanner --recursive .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "clean": "turbo run clean && rm -rf node_modules",
    "gate:pinning": "node scripts/pinning-gate.mjs",
    "gate:invariants": "node scripts/invariant-registry.mjs",
    "gate:board": "node scripts/count-tasks.mjs",
    "gate:bundle": "node scripts/check-bundle-budget.mjs",
    "gate:schema": "node scripts/schema-gate.mjs",
    "gates": "pnpm run gate:schema && pnpm run gate:board && pnpm run gate:invariants && pnpm run gate:pinning && pnpm run gate:bundle && pnpm run gate:authz && pnpm run gate:migrate && pnpm run gate:subjects",
    "sim:validate": "node scripts/sim-validate.mjs --all",
    "sim:new": "node scripts/sim-new.mjs",
    "sim:build": "node scripts/sim-build.mjs --all",
    "sim:conformance": "node scripts/sim-conformance.mjs",
    "sim:sandbox-escape": "node scripts/sim-sandbox-escape.mjs",
    "gate:browser": "pnpm run sim:sandbox-escape && pnpm run sim:conformance",
    "sim:playground": "node scripts/sim-playground.mjs",
    "test:sims": "vitest run --config sims/vitest.config.ts",
    "sim:check": "node scripts/sim-build.mjs --all --check",
    "gate:authz": "node scripts/authz-ownership-gate.mjs",
    "test:integration": "pnpm --filter @orrery/db --filter @orrery/worker test:integration",
    "gate:migrate": "node scripts/migration-corpus-gate.mjs",
    "gate:subjects": "node scripts/subject-tree-gate.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@eslint/js": "^9",
    "@prisma/client": "^6",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.0.0",
    "globals": "17.11.0",
    "jest-axe": "11.0.0",
    "jsdom": "30.1.1",
    "prisma": "^6",
    "playwright": "1.56.1",
    "turbo": "^2.0.0",
    "typescript": "^5.9.0",
    "esbuild": "0.28.2",
    "typescript-eslint": "8.67.0",
    "vitest": "^3.0.0",
    "zod": "4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "@types/katex": "0.16.8",
    "better-auth": "1.7.6",
    "katex": "0.18.9",
    "zod": "4.4.3"
  }
}
